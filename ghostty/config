# Font Configuration
font-family = Iosevka
font-size = 15

# Letter spacing (disable ligatures for tighter spacing)
font-feature = -liga
font-feature = -calt

# Window Settings
window-padding-x = 0
window-padding-y = 0
scrollback-limit = 5000000

# Shell - login shell equivalent
shell-integration-features = no-cursor

# Cursor
cursor-style = block
cursor-color = #657b83
cursor-style-blink = true

# Mouse
mouse-hide-while-typing = true

# Theme - custom colors matching urxvt dark theme
background = #090300
foreground = #a5a2a2
palette = 0=#090300
palette = 1=#db2d20
palette = 2=#01a252
palette = 3=#fded02
palette = 4=#01a0e4
palette = 5=#a16a94
palette = 6=#b5e4f4
palette = 7=#a5a2a2
palette = 8=#5c5855
palette = 9=#db2d20
palette = 10=#01a252
palette = 11=#fded02
palette = 12=#01a0e4
palette = 13=#a16a94
palette = 14=#b5e4f4
palette = 15=#f7f7f7

# URL handling
link-url = true

# Copy/Paste keybindings (Alt+C/V as in urxvt, Shift+Ctrl for compatibility)
keybind = alt+c=copy_to_clipboard
keybind = alt+v=paste_from_clipboard

keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# Font resizing (Ctrl+- / Ctrl+= / Ctrl++)
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+equal=reset_font_size

# Command palette (closest to urxvt keyboard-select mode)
keybind = ctrl+shift+p=toggle_command_palette

# Clipboard
clipboard-read = allow
clipboard-write = allow
